{
  "name": "eslint-config-taeyoon",
  "description": "Pre-defined eslint config for taeyoon0137's personal projects",
  "version": "0.2.1",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/configs/base.js",
  "exports": {
    ".": {
      "require": "./dist/configs/base.js",
      "import": "./dist/configs/base.js",
      "types": "./dist/configs/base.d.ts"
    },
    "./base": {
      "require": "./dist/configs/base.js",
      "import": "./dist/configs/base.js",
      "types": "./dist/configs/base.d.ts"
    },
    "./react": {
      "require": "./dist/configs/react.js",
      "import": "./dist/configs/react.js",
      "types": "./dist/configs/react.d.ts"
    },
    "./react-native": {
      "require": "./dist/configs/react-native.js",
      "import": "./dist/configs/react-native.js",
      "types": "./dist/configs/react-native.d.ts"
    },
    "./prettier": "./.prettierrc.json",
    "./package.json": "./package.json"
  },
  "files": [
    "./dist",
    "./AGENTS.md",
    "./.prettierrc.json",
    "./tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/taeyoon0137/eslint-config-taeyoon.git",
    "directory": "./"
  },
  "author": {
    "name": "Taeyoon Lee",
    "email": "taeyoon0137@gmail.com",
    "url": "https://github.com/taeyoon0137"
  },
  "scripts": {
    "build": "yarn build:clear && yarn build:types",
    "build:clear": "rm -rf dist",
    "build:types": "tsc -b && tsc-alias",
    "readme:update": "./scripts/readme_update.sh",
    "test": "yarn build && yarn test:smoke",
    "test:smoke": "yarn node tests/smoke.cjs"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.1",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^9.7.0"
  },
  "packageManager": "yarn@4.16.0+sha512.5374c94eb4ef6aa8188fb112f20c1aa6569f248d676c5e576e1fd2a1a4d8d87a96df65d9dfe1c2a0252cbe38bda46cf18d955005b81b43cc7607a5c9d56fd2b6",
  "dependencies": {
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.4.1"
  }
}
